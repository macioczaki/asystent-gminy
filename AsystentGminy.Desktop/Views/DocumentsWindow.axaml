<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AsystentGminy.Desktop.ViewModels"
        xmlns:models="using:AsystentGminy.Desktop.Models"
        x:Class="AsystentGminy.Desktop.Views.DocumentsWindow"
        x:DataType="vm:DocumentsViewModel"
        Title="Zarządzanie dokumentami"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Default">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="16">

        <!-- Nagłówek -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Zarządzanie dokumentami" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Lista dokumentów zaindeksowanych w bazie wiedzy"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="🔄 Odśwież"
                    Command="{Binding LoadCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    VerticalAlignment="Center"
                    Padding="16,8"/>
        </Grid>

        <!-- Lista dokumentów -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Documents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DocumentDto">
                            <Border Padding="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                                <Run Text="📅 "/>
                                                <Run Text="{Binding CreatedAtFormatted}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                                <Run Text="📄 "/>
                                                <Run Text="{Binding ChunkCountText}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="🗑 Usuń"
                                            Command="{Binding $parent[Window].((vm:DocumentsViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding $parent[Window].((vm:DocumentsViewModel)DataContext).IsLoading, Converter={x:Static BoolConverters.Not}}"
                                            VerticalAlignment="Center"
                                            Padding="12,6"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </Grid>
</Window>