<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AsystentGminy.Desktop.ViewModels"
        xmlns:models="using:AsystentGminy.Desktop.Models"
        x:Class="AsystentGminy.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Asystent Gminy"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Default">

    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8" Margin="16">

        <!-- Nagłówek -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Asystent Gminy" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Zadaj pytanie o dokumenty urzędowe"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       FontSize="12"/>
        </StackPanel>

        <!-- Lista wiadomości -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      x:Name="MessageScrollViewer">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Margin="0,6">
                            <!-- User: wyrównanie do prawej -->
                            <Border HorizontalAlignment="Right"
                                    MaxWidth="600"
                                    Padding="14,10"
                                    CornerRadius="12"
                                    Background="{DynamicResource SystemAccentColor}"
                                    IsVisible="{Binding IsUser}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Foreground="White"/>
                                    <Button Content="Kopiuj"
                                            FontSize="10"
                                            Padding="6,2"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            Foreground="White"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyMessageCommand}"
                                            CommandParameter="{Binding Content}"/>
                                </StackPanel>
                            </Border>

                            <!-- Assistant: wyrównanie do lewej -->
                            <Border HorizontalAlignment="Left"
                                    MaxWidth="700"
                                    Padding="14,10"
                                    CornerRadius="12"
                                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding !IsUser}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"/>

                                    <!-- Przycisk Kopiuj -->
                                    <Button Content="Kopiuj"
                                            FontSize="10"
                                            Padding="6,2"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyMessageCommand}"
                                            CommandParameter="{Binding Content}"/>

                                    <!-- Źródła -->
                                    <ItemsControl ItemsSource="{Binding Sources}"
                                                  IsVisible="{Binding HasSources}"
                                                  Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SourceReference">
                                                <Border Margin="0,3"
                                                        Padding="10"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SystemAccentColor}">
                                                            <Run Text="["/><Run Text="{Binding Index}"/><Run Text="] "/>
                                                            <Run Text="{Binding DocumentTitle}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Excerpt}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Wskaźnik "Pisze..." -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsBusy}"
                    Margin="4,0,0,0">
            <TextBlock Text="⏳" FontSize="14"/>
            <TextBlock Text="{Binding StatusText}"
                       FontStyle="Italic"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <!-- Pole pytania -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding Question}"
                     PlaceholderText="Zadaj pytanie, np. Jakie zadania realizuje wójt gminy?"
                     IsEnabled="{Binding !IsBusy}"
                     FontSize="14"
                     Padding="10,8">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AskCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Content="Wyślij"
                    Command="{Binding AskCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Margin="8,0,0,0"
                    Padding="24,8"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>